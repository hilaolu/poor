{
  "name": "poor",
  "version": "2.0.0",
  "description": "Pi extension with workspace-style bash_exec, exact apply_patch, and a complete instruction profile",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "apply-patch", "codex"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "audit:prompt": "node scripts/audit-prompts.ts artifacts/bash-prompt-audit --verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1 <1",
    "@earendil-works/pi-tui": ">=0.85.1 <1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
